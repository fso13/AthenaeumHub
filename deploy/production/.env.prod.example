# Сова — production environment template.
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#   replace every CHANGE_ME / example.com value
#   generate each secret independently:
#     openssl rand -base64 48 | tr -d '\n'
#
# .env.prod is ignored by git and must never be committed, pasted into a ticket
# or copied into a backup archive that is not encrypted at rest.

# ---------------------------------------------------------------------------
# Public names and ACME
# ---------------------------------------------------------------------------
# A/AAAA for both names must point at this host. FILES_DOMAIN must differ from
# DOMAIN; it is the browser-visible host for MinIO presigned download URLs.
DOMAIN=chat.example.com
FILES_DOMAIN=files.chat.example.com
ACME_EMAIL=ops@example.com
# Let's Encrypt production by default. For a staging dry run use:
# https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

KRUG_APP_VERSION=0.1.0
# `prod` adds the strict startup guard and removes dev endpoints; `keycloak`
# supplies the OIDC/BFF production defaults. Do not use `dev` in production.
SPRING_PROFILES_ACTIVE=keycloak,prod

# ---------------------------------------------------------------------------
# Application PostgreSQL
# ---------------------------------------------------------------------------
# krug_migrator owns Flyway/DDL; krug_app is the least-privilege runtime role
# created by db-bootstrap. Use different random values for each.
KRUG_DB_PASSWORD=CHANGE_ME
KRUG_APP_PASSWORD=CHANGE_ME
DB_POOL_SIZE=20

# ---------------------------------------------------------------------------
# Application secrets (32+ characters; ProdGuard rejects short/dev values)
# ---------------------------------------------------------------------------
# Required by the prod profile. Keycloak-issued tokens are used, but a strong
# value is still mandatory so the deployment cannot inherit a dev secret.
KRUG_AUTH_JWT_SECRET=CHANGE_ME
# AES-256-GCM key material for managed message bodies. LOSING THIS KEY MAKES
# EXISTING MESSAGES UNREADABLE: escrow it in a secret manager before go-live.
KRUG_CONTENT_KEY=CHANGE_ME
# Dedicated key for encrypted email/TOTP secrets; keep independent of the
# content key so it can be rotated separately.
KRUG_AUTH_BFF_EMAIL_SECRET_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=CHANGE_ME

# Bootstrap master-realm admin. Used only to provision the runtime technical
# user and for break-glass; it is never configured in the backend.
KC_BOOTSTRAP_ADMIN_USER=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# #103: runtime Keycloak Admin API client-credentials service account. The
# confidential client `svc-krug-bff` lives in the `krug` realm (never master,
# never admin-cli) and its service-account user gets only
# manage-users/view-users/query-users on `realm-management`. The client is
# imported from realm-export.prod.json; realm-init substitutes this secret.
# Master/admin-cli and the old technical password user are not used at runtime.
KRUG_KEYCLOAK_SERVICE_CLIENT_ID=svc-krug-bff
KRUG_KEYCLOAK_SERVICE_CLIENT_SECRET=CHANGE_ME
# Operator contact only; not an authentication credential.
KC_ADMIN_EMAIL=ops@example.com

# #103: HttpOnly refresh cookie. ProdGuard requires secure=true; keep HTTPS.
KRUG_AUTH_BFF_COOKIE_SECURE=true
# Credentialed CORS/CSRF allowlist. Defaults to the same public origin as the SPA
# (KRUG_WS_ALLOWED_ORIGINS in docker-compose.prod.yml); set explicitly only for
# a split-origin deployment. Never '*'.
KRUG_CORS_ALLOWED_ORIGINS=https://chat.example.com

# ---------------------------------------------------------------------------
# Real SMTP (replaces Mailpit)
# ---------------------------------------------------------------------------
# Port 587 + STARTTLS is the supported production path. Port 465 implicit TLS
# is not exposed by the current Spring mail configuration (code follow-up).
# Runtime SMTP settings saved in the admin panel override these values.
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=CHANGE_ME
SPRING_MAIL_PASSWORD=CHANGE_ME
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
# Must be an address the relay is allowed to send as (SPF/DKIM aligned).
KRUG_MAIL_FROM=no-reply@example.com

# ---------------------------------------------------------------------------
# S3 / MinIO
# ---------------------------------------------------------------------------
# MinIO root credentials. The S3 API is not published directly; Caddy exposes
# only presigned GETs on FILES_DOMAIN. Use long random values.
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=krug
S3_REGION=us-east-1
# noop is a launch blocker for production. Enable the `scan` profile only
# after the ClamAV signature database has been primed (see runbook).
S3_SCAN_MODE=noop
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---------------------------------------------------------------------------
# Feature flags and optional settings
# ---------------------------------------------------------------------------
# Keep false until the E2EE release gate is closed.
KRUG_E2EE_ENABLED=false
KRUG_OIDC_AUDIENCE=krug-api
KRUG_OIDC_AZP=krug-web

# Optional self-hosted translation (#104). Internal only; no public provider.
# Enable the compose profile and set the URL:
#   docker compose --env-file .env.prod --profile translate up -d libretranslate
#   KRUG_PLUGINS_TRANSLATE_URL=http://libretranslate:5000/translate
#   KRUG_PLUGINS_TRANSLATE_PROVIDER=libretranslate
#   LT_LOAD_ONLY=en,ru
# Models are downloaded on first start into a named volume (2-4 GB RAM, 2 vCPU,
# ~1-2 GB disk for en+ru). Access is limited to the internal network.
# KRUG_PLUGINS_TRANSLATE_URL=
# KRUG_PLUGINS_TRANSLATE_PROVIDER=libretranslate
# LT_LOAD_ONLY=en,ru

# ---------------------------------------------------------------------------
# Backups (read by deploy/scripts/backup.sh; not used by compose)
# ---------------------------------------------------------------------------
# Use a separate disk/volume, not the compose directory. 0700/0600 only.
KRUG_BACKUP_DIR=/srv/backups/krug
KRUG_BACKUP_RETENTION_DAYS=30
