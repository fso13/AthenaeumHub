# Copy to deploy/.env and replace every "change-me" value.
# Generate secrets: openssl rand -base64 48

# Public SPA origin. Must match the Keycloak redirect URI and the browser URL.
PUBLIC_URL=http://localhost:8088
# Public WebSocket URL (same origin through nginx).
PUBLIC_WS_URL=ws://localhost:8088/ws
APP_PORT=8088

# PostgreSQL superuser/flyway password. The runtime krug_app role is created
# by V1 with its own password; keep the database port local-only.
KRUG_APP_PASSWORD=change-me-app-db-password
KRUG_DB_PASSWORD=change-me-db-password

# Application secrets (32+ bytes). Never reuse dev defaults.
KRUG_AUTH_JWT_SECRET=change-me-auth-jwt-secret-at-least-32-bytes
KRUG_CONTENT_KEY=change-me-content-key-at-least-32-bytes

# Dedicated PostgreSQL for Keycloak (separate from the application database).
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=change-me-keycloak-db-password

# Keycloak bootstrap admin. Demo user: test@krug.local / Test1234! (login is email)
KRUG_MAIL_FROM=no-reply@krug.local
KC_PUBLIC_URL=http://localhost:8180
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-keycloak-admin

# S3-compatible storage (MinIO in this compose; use real S3/Ceph for prod).
# S3_PUBLIC_ENDPOINT is what the browser uses for presigned URLs; it must be
# reachable from users' browsers (not the Docker-internal minio host).
S3_ACCESS_KEY=change-me-s3-access
S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET=krug
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT=http://localhost:9000

# noop = demo AV (no ClamAV container); clamav requires --profile scan.
S3_SCAN_MODE=noop
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Keep E2EE disabled until the crypto review / browser E2E gate is closed.
KRUG_E2EE_ENABLED=false

KRUG_APP_VERSION=0.1.0
