# Базовый URL API. Пустое значение: в mock-режиме — /api/v1,
# в real-режиме — http://localhost:8081/api/v1.
VITE_API_BASE_URL=

# Для real-режима раскомментируйте:
# VITE_API_BASE_URL=http://localhost:8081/api/v1

# Dev-прокси Vite для real-режима (если у backend выключен CORS).
# VITE_API_PROXY_TARGET=http://localhost:8081

# true — MSW (по умолчанию в dev), false — реальный backend.
# Локальный порт «Круга» — 8081: 8080 в этом окружении занят другим проектом.
VITE_USE_MOCKS=true

# dev — dev-сессия POST /dev/session (F-01, fallback).
# password — собственные формы Auth BFF: /auth/login, /auth/register,
# /auth/verify-email, /auth/refresh, /auth/logout. Браузер не ходит в Keycloak.
# Production: VITE_AUTH_MODE=password.
VITE_AUTH_MODE=dev

# true — при старте/401 выполнять POST /dev/session (backend-профиль dev).
VITE_DEV_SESSION=true

# Имя и версия устройства для POST /devices.
VITE_DEVICE_NAME=Круг — браузер
VITE_APP_VERSION=0.1.0

# --- E3 realtime WebSocket ---
# Включён по умолчанию; false оставляет REST/sync без WS.
VITE_REALTIME_ENABLED=true

# Необязательный override endpoint. Пусто — ticket.ws_url; loopback-адрес
# бэкенда в dev автоматически идёт через same-origin /ws proxy.
# VITE_WS_URL=/ws
# VITE_WS_URL=wss://rt.krug.example/ws

# Dev-прокси Vite для /ws (ws: true). По умолчанию — VITE_API_PROXY_TARGET
# или http://localhost:8081.
# VITE_WS_PROXY_TARGET=http://localhost:8081

# --- E4-F managed files ---
# Origin(ы) presigned URL (MinIO/S3) через запятую; попадают в CSP
# img-src/media-src/connect-src production-сборки. В dev CSP не вставляется.
VITE_MEDIA_ORIGINS=http://localhost:9002

# --- E6-F in-app notifications ---
# Отдельных env нет: размер страницы — контрактный default 30, а обновление
# badge/list идёт на bootstrap, после /sync и после live message.created.
# Периодичность наследуется от syncIntervalMs (30 с).
