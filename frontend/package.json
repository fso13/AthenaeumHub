{
  "name": "krug-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "«Сова» — managed chat + Keycloak OIDC (F-04)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "test:e2e:d1": "playwright test --config playwright.dashboard.config.ts",
    "test:e2e:e2ee": "E2EE_BROWSER_MATRIX=1 playwright test --config playwright.e2ee.config.ts",
    "test:e2e:e2ee:real": "E2EE_REAL=1 playwright test --config playwright.e2ee-real.config.ts",
    "test:e2e:admin": "playwright test --config playwright.auth.config.ts admin.spec.ts",
    "test:e2e:files:real": "playwright test --config playwright.real.config.ts files.real.spec.ts",
    "test:e2e:notifications:real": "playwright test --config playwright.real.config.ts notifications.real.spec.ts",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "test:e2e:ws": "playwright test --config playwright.ws.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.d.ts",
    "contract:check": "node scripts/check-contract.mjs",
    "security:check": "node scripts/check-security.mjs",
    "stickers:check": "node scripts/check-stickers.mjs",
    "check": "npm run lint && npm run format:check && npm run contract:check && npm run stickers:check && npm run security:check && npm run session-writers:check && npm run test && npm run build",
    "msw:init": "msw init public --save",
    "session-writers:check": "node scripts/check-session-writers.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
